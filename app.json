{
  "expo": {
    "name": "Faithful Companion",
    "slug": "faithful-companion",
    "version": "1.0.0",
    "description": "Your daily companion for Bible study, prayer, and spiritual growth. Join study groups, track your faith journey, and connect with a community of believers.",
    "privacy": "public",
    "primaryColor": "#7b4d62",
    "assetBundlePatterns": [
      "**/*"
    ],
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "faithfulcompanion",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "jsc",
    "splash": {
      "image": "./assets/images/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.faithfulcompanion.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "This app uses the camera to update your profile picture.",
        "NSPhotoLibraryUsageDescription": "This app needs access to your photos to update your profile picture.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "faithfulcompanion",
            "CFBundleURLSchemes": [
              "faithfulcompanion"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.faithfulcompanion.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "faithfulcompanion.ai",
              "pathPrefix": "/auth/callback"
            },
            {
              "scheme": "faithfulcompanion"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "RECEIVE_BOOT_COMPLETED",
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    },
    "notification": {
      "icon": "./assets/images/icon.png",
      "color": "#7B4D62",
      "androidMode": "default",
      "androidCollapsedTitle": "#{unread_notifications} new updates"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#7b4d62",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "YOUR_PROJECT_ID_HERE"
      },
      "supportEmail": "support@faithfulcompanion.ai",
      "privacyPolicyUrl": "https://faithfulcompanion.ai/privacy",
      "termsOfServiceUrl": "https://faithfulcompanion.ai/terms"
    },
    "hooks": {
      "postPublish": []
    }
  }
}
